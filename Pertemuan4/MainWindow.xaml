<Window x:Class="EmployeeRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Registration"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="EMPLOYEE REGISTRATION"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>
            
            <TextBlock Text="NIK (Nomor Induk Karyawan)"/>
            <TextBox x:Name="txtNik"
                     Height="35"
                     Margin="0,5,0,15"/>
            
            <TextBlock Text="Nama Pegawai"/>
            <TextBox x:Name="txtNama"
                     Height="35"
                     Margin="0,5,0,15"/>
            
            <TextBlock Text="Departemen"/>
            <ComboBox x:Name="cmbDepartemen"
                      Height="35"
                      Margin="0,5,0,15">
                <ComboBoxItem Content="IT (Information Technology)"/>
                <ComboBoxItem Content="Human Resources (HR)"/>
                <ComboBoxItem Content="Finance"/>
                <ComboBoxItem Content="Marketing"/>
            </ComboBox>
            
            <TextBlock Text="Jenis Kelamin"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,15">
                <RadioButton x:Name="rbLaki"
                             Content="Laki-laki"
                             Margin="0,0,20,0"/>
                <RadioButton x:Name="rbPerempuan"
                             Content="Perempuan"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Simpan"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnSimpan_Click"/>
                <Button Content="Reset"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="BtnReset_Click"/>
                <Button Content="Hapus"
                        Width="100"
                        Height="40"
                        Click="BtnHapus_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- DATA -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="DATA PEGAWAI"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Search Bar -->
            <TextBlock Text="Cari Pegawai"
                       Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch"
                         Grid.Column="0"
                         Height="35"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button x:Name="btnClearSearch"
                        Grid.Column="2"
                        Content="✕"
                        Width="35"
                        Height="35"
                        ToolTip="Bersihkan pencarian"
                        Click="BtnClearSearch_Click"/>
            </Grid>

            <!-- Hasil Counter -->
            <TextBlock x:Name="lblSearchInfo"
                       Text=""
                       FontSize="11"
                       Foreground="Gray"
                       Margin="0,0,0,5"/>

            <ListBox x:Name="lstPegawai"
                     Height="310"/>
        </StackPanel>
    </Grid>
</Window>